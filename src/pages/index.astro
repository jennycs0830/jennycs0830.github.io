---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, research, publications, experience, education } from '../data/site.js';
---
<BaseLayout title="Yi-Jyun Sun | Research Portfolio" description="Research portfolio of Yi-Jyun (Jenny) Sun, computer science graduate student at UIUC.">
  <div class="site-shell">
    <header class="site-header">
      <a class="wordmark" href="#top">Yi-Jyun Sun</a>
      <nav aria-label="Main navigation">
        <a href="#research">Research</a><a href="#publications">Publications</a><a href="#experience">Experience</a><a href="#outside">Outside the lab</a>
      </nav>
    </header>

    <main id="top">
      <section class="intro" id="about">
        <p class="eyebrow">M.S. student · Computer Science · UIUC</p>
        <h1>Hi, I’m Jenny.</h1>
        <p class="lede">I’m Yi-Jyun Sun, a graduate student at the University of Illinois Urbana-Champaign. I study how language technologies can help people work with complex information, especially in healthcare, education, and conversational AI.</p>
        <p class="contact-line">Illinois, United States <span>·</span> <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a> <span>·</span> <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a></p>
      </section>

      <section class="content-section" id="research">
        <div class="section-heading"><p class="eyebrow">What I work on</p><h2>Selected research</h2></div>
        <div class="research-list">
          {research.map((item) => <article class="research-item">
            <div class="item-title"><h3>{item.title}</h3><span>{item.area}</span></div>
            <p>{item.description}</p>
            <small>{item.note}</small>
          </article>)}
        </div>
      </section>

      <section class="content-section" id="publications">
        <div class="section-heading"><p class="eyebrow">Papers & writing</p><h2>Publications</h2></div>
        <ol class="publication-list">
          {publications.map((paper) => <li>
            <div><p class="paper-title">{paper.title}</p><p class="paper-authors">{paper.authors}</p><p class="paper-venue">{paper.venue}</p></div>
            <span class={`status ${paper.status === 'Published' ? 'published' : ''}`}>{paper.status}</span>
          </li>)}
        </ol>
      </section>

      <section class="content-section" id="experience">
        <div class="section-heading"><p class="eyebrow">Research & industry</p><h2>Experience</h2></div>
        <div class="experience-list">
          {experience.map((item) => <article class="experience-item">
            <div><h3>{item.role}</h3><p class="org">{item.org}</p><p class="detail">{item.detail}</p></div>
            <p class="dates">{item.dates}</p>
          </article>)}
        </div>
      </section>

      <section class="content-section education-section" id="education">
        <div class="section-heading"><p class="eyebrow">A little about my path</p><h2>Education</h2></div>
        <div class="education-list">
          {education.map((item) => <article><div><h3>{item.degree}</h3><p class="org">{item.school}</p><p class="detail">{item.detail}</p></div><p class="dates">{item.dates}</p></article>)}
        </div>
      </section>

      <section class="content-section outside-section" id="outside">
        <div class="section-heading"><p class="eyebrow">Life beyond research</p><h2>Outside the lab</h2></div>
        <div class="basketball-note">
          <div class="court-mark" aria-hidden="true"><span></span></div>
          <div>
            <h3>Basketball</h3>
            <p>Basketball is one of the things I keep coming back to. I love the pace of the game, the teamwork, and the small decisions that change a play. My interest has followed me off the court too: I put together a small dataset of basketball clips labeled for defense, dribbling, shooting, passing, and more.</p>
            <a class="text-link" href="https://github.com/jennycs0830/basketball_action_dataset" target="_blank" rel="noreferrer">Basketball action dataset <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="content-section cv-section" id="cv">
        <div class="section-heading"><p class="eyebrow">Curriculum vitae</p><h2>CV</h2></div>
        <p class="cv-copy">For a full CV, please reach out through <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>. I’m confirming the email address listed on my current resume before adding a downloadable copy.</p>
      </section>
    </main>

    <footer><span>© {new Date().getFullYear()} Yi-Jyun Sun</span><a href="#top">Back to top ↑</a></footer>
  </div>
  <style is:global>
    :root { background:#fff; color:#202321; font-family:'DM Sans',Arial,sans-serif; }
    body { margin:0; }
    a { color:#426a56; text-underline-offset:3px; }
    a:hover { color:#254733; }
    .site-shell { width:min(100% - 48px, 800px); margin:0 auto; }
    .site-header { min-height:72px; display:flex; align-items:center; justify-content:space-between; gap:24px; border-bottom:1px solid #e9ece9; }
    .wordmark { color:#202321; font-size:14px; font-weight:600; text-decoration:none; white-space:nowrap; }
    .site-header nav { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:20px; }
    .site-header nav a { color:#606762; font-size:12px; text-decoration:none; }
    .site-header nav a:hover { color:#254733; }
    .intro { padding:76px 0 58px; }
    .eyebrow { margin:0 0 10px; color:#68816e; font-size:11px; letter-spacing:.075em; text-transform:uppercase; }
    h1,h2,h3,p { margin-top:0; }
    h1 { margin-bottom:20px; font-family:'Newsreader',Georgia,serif; font-size:54px; font-weight:400; letter-spacing:-.035em; }
    .lede { max-width:660px; margin-bottom:22px; color:#4e5550; font-size:17px; line-height:1.75; }
    .contact-line { margin:0; color:#777e79; font-size:12px; }
    .contact-line span { padding:0 7px; color:#b3b9b4; }
    .contact-line a { color:#4f6b56; }
    .content-section { padding:43px 0 47px; border-top:1px solid #e9ece9; }
    .section-heading { margin-bottom:23px; }
    .section-heading .eyebrow { margin-bottom:5px; }
    h2 { margin-bottom:0; font-family:'Newsreader',Georgia,serif; font-size:31px; font-weight:400; letter-spacing:-.02em; }
    h3 { margin-bottom:4px; font-size:15px; font-weight:600; }
    .research-list { display:grid; grid-template-columns:1fr 1fr; column-gap:38px; }
    .research-item { padding:17px 0 19px; border-top:1px solid #edf0ed; }
    .item-title { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:4px 12px; }
    .item-title span,.research-item small { color:#79807b; font-size:10px; }
    .research-item p { margin:7px 0 8px; color:#626964; font-size:12px; line-height:1.65; }
    .publication-list { margin:0; padding:0; list-style:none; }
    .publication-list li { display:grid; grid-template-columns:1fr auto; gap:16px; padding:16px 0; border-top:1px solid #edf0ed; }
    .paper-title { max-width:650px; margin:0 0 4px; font-size:13px; font-weight:600; line-height:1.55; }
    .paper-authors,.paper-venue { margin:0; color:#707772; font-size:11px; line-height:1.6; }
    .paper-venue { margin-top:2px; color:#526b58; }
    .status { align-self:start; padding-top:2px; color:#a26b45; font-size:9px; letter-spacing:.04em; text-transform:uppercase; white-space:nowrap; }
    .status.published { color:#547259; }
    .experience-item,.education-list article { display:grid; grid-template-columns:1fr auto; gap:18px; padding:16px 0; border-top:1px solid #edf0ed; }
    .org { margin:0 0 6px; color:#566e5c; font-size:12px; }
    .detail { max-width:600px; margin:0; color:#666d68; font-size:12px; line-height:1.65; }
    .dates { margin:2px 0 0; color:#7c837e; font-size:10px; white-space:nowrap; }
    .basketball-note { display:grid; grid-template-columns:130px 1fr; gap:26px; align-items:center; padding:22px; background:#f7f8f5; }
    .basketball-note h3 { margin-bottom:9px; font-family:'Newsreader',Georgia,serif; font-size:23px; font-weight:400; }
    .basketball-note p { max-width:560px; margin:0 0 12px; color:#626964; font-size:13px; line-height:1.75; }
    .text-link { font-size:11px; }
    .court-mark { position:relative; display:grid; width:122px; height:122px; place-items:center; overflow:hidden; border:1px solid #d4ddd3; border-radius:50%; background:#edf2ea; }
    .court-mark::before { width:72px; height:72px; border:1px solid #9bb09b; border-radius:50%; content:''; }
    .court-mark::after { position:absolute; top:0; bottom:0; width:1px; background:#9bb09b; content:''; }
    .court-mark span { position:absolute; left:0; right:0; height:1px; background:#9bb09b; }
    .cv-copy { margin:0; color:#626964; font-size:13px; line-height:1.7; }
    footer { display:flex; justify-content:space-between; padding:20px 0 30px; border-top:1px solid #e9ece9; color:#89908b; font-size:10px; }
    footer a { text-decoration:none; }
    @media (max-width:620px) {
      .site-shell { width:min(100% - 36px, 800px); }
      .site-header { align-items:flex-start; flex-direction:column; gap:12px; padding:17px 0; }
      .site-header nav { justify-content:flex-start; gap:12px 17px; }
      .site-header nav a { font-size:11px; }
      .intro { padding:52px 0 42px; }
      h1 { font-size:46px; }
      .lede { font-size:15px; }
      .research-list { grid-template-columns:1fr; }
      .publication-list li,.experience-item,.education-list article { grid-template-columns:1fr; gap:5px; }
      .status { grid-row:1; }
      .publication-list li { gap:6px; }
      .basketball-note { grid-template-columns:1fr; gap:18px; padding:19px; }
      .court-mark { width:86px; height:86px; }
      .court-mark::before { width:50px; height:50px; }
      .dates { grid-row:1; }
    }
  </style>
</BaseLayout>
