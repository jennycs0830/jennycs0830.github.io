---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, research, publications, experience, education, service } from '../data/site.js';
const selectedPublications = publications.filter((paper) => paper.status === 'Published');
---
<BaseLayout title="Yi-Jyun Sun | Research Portfolio" description="Research portfolio of Yi-Jyun (Jenny) Sun, M.S. thesis student in Computer Science at UIUC.">
  <div class="site-shell">
    <aside class="profile-sidebar" aria-label="Profile">
      <img class="sidebar-photo" src="/images/jenny-headshot.jpg" alt="Portrait of Yi-Jyun (Jenny) Sun" fetchpriority="high" />
      <h1 class="sidebar-name" id="intro-heading">Yi-Jyun (Jenny) Sun</h1>
      <p class="sidebar-role">M.S. student · Computer Science</p>
      <p class="sidebar-affiliation"><a class="affiliation-link" href="https://uiuc-conversational-ai-lab.github.io" target="_blank" rel="noreferrer">ConvAI Lab</a> · UIUC</p>
      <nav class="profile-links" aria-label="Personal links">
        <a class="profile-link" href={profile.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn" title="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.44-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
        <a class="profile-link" href={profile.scholar} target="_blank" rel="noreferrer" aria-label="Google Scholar" title="Google Scholar">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3Zm-6 9.27v4.2c0 2.5 2.69 4.53 6 4.53s6-2.03 6-4.53v-4.2l-6 3.27-6-3.27Z"/></svg>
        </a>
        <a class="profile-link" href={profile.github} target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.1c-3.1.68-3.75-1.32-3.75-1.32-.5-1.29-1.23-1.63-1.23-1.63-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15 1 .1.26 1.42 2.97 1.08.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.21 1.15-2.99-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.11-1.44 3.05-1.14 3.05-1.14.61 1.54.23 2.68.11 2.96.72.78.26 1.42.26 2.97 0 2.61 2.08 5.24 5.1 5.52.4.35.75 1.03.75 2.08v3.09c0 .3.21.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>
        </a>
      </nav>
    </aside>
    <div class="page-content">
      <section class="profile-intro" id="top" aria-labelledby="intro-heading">
        <div class="profile-intro-copy">
          <p class="lede">Advised by Professor <a class="affiliation-link" href="https://siebelschool.illinois.edu/about/people/faculty/dilek" target="_blank" rel="noreferrer">Dilek Hakkani-Tür</a> and <a class="affiliation-link" href="https://siebelschool.illinois.edu/about/people/faculty/gokhan" target="_blank" rel="noreferrer">Gökhan Tür</a>, I focus on applied AI for healthcare and education. I’m especially interested in how agentic AI systems can support people through complex, real-world workflows and improve human well-being.</p>
          <p class="contact-line">{profile.location}</p>
        </div>
      </section>

      <header class="site-header">
        <nav aria-label="Main navigation">
          <a href="#research">Research</a><a href="#publications">Publications</a><a href="#service">Service</a><a href="#experience">Experience</a><a href="#outside">Outside the lab</a>
        </nav>
      </header>

    <main>
      <section class="content-section" id="research">
        <div class="section-heading"><p class="eyebrow">What I work on</p><h2>Selected research</h2></div>
        <div class="research-list">
          {research.map((item) => <article class="research-item">
            <div class="item-title"><h3>{item.title}</h3><span>{item.area}</span></div>
            <p>{item.description}</p>
            <small>{item.note}</small>
          </article>)}
        </div>
      </section>

      <section class="content-section" id="publications">
        <div class="section-heading"><p class="eyebrow">Papers & writing</p><h2>Selected publications</h2></div>
        <ol class="publication-list">
          {selectedPublications.map((paper) => <li class:list={['publication-item', paper.visual && 'has-visual']}>
            <div class="publication-aside">
              {paper.visual && <figure class="publication-figure"><img src={paper.visual} alt={paper.visualAlt} loading="lazy" /></figure>}
            </div>
            <div class="publication-copy">
              <p class="paper-title">{paper.title}</p>
              <p class="paper-authors">{paper.authors.split(/(Y\.-J\. Sun)/).map((author) => author === 'Y.-J. Sun' ? <strong class="author-self">{author}</strong> : author)}</p>
              <p class="paper-venue">{paper.venue}</p>
              <div class="paper-links">
                {paper.url && <a class="paper-link" href={paper.url} target="_blank" rel="noreferrer">Paper <span aria-hidden="true">↗</span></a>}
                {paper.codeUrl && <a class="paper-link" href={paper.codeUrl} target="_blank" rel="noreferrer">Code <span aria-hidden="true">↗</span></a>}
              </div>
              <span class={`status ${paper.status === 'Published' ? 'published' : ''}`}>{paper.status}</span>
            </div>
          </li>)}
        </ol>
        <a class="all-papers-link" href="/publications/">All papers <span aria-hidden="true">↗</span></a>
      </section>

      <section class="content-section service-section" id="service">
        <div class="section-heading"><p class="eyebrow">Community contributions</p><h2>Service</h2></div>
        <div class="service-grid">
          {service.map((group) => <article class="service-group">
            <h3>{group.category}</h3>
            <ul>
              {group.items.map((item) => <li><span class="service-year">{item.year}</span><span>{item.role}</span></li>)}
            </ul>
          </article>)}
        </div>
      </section>

      <section class="content-section" id="experience">
        <div class="section-heading"><p class="eyebrow">Research & industry</p><h2>Experience</h2></div>
        <div class="experience-list">
          {experience.map((item) => <article class="experience-item">
            <span class="company-logo"><img src={item.logo} alt={item.logoAlt} loading="lazy" /></span>
            <div>
              <h3>{item.role}</h3>
              <p class="org">{item.role === 'Graduate Research Assistant' ? <><a class="affiliation-link" href="https://uiuc-conversational-ai-lab.github.io" target="_blank" rel="noreferrer">ConvAI Lab</a> · University of Illinois Urbana-Champaign</> : item.org}</p>
              <p class="detail">{item.detail}</p>
            </div>
            <p class="dates">{item.dates}</p>
          </article>)}
        </div>
      </section>

      <section class="content-section education-section" id="education">
        <div class="section-heading"><p class="eyebrow">A little about my path</p><h2>Education</h2></div>
        <div class="education-list">
          {education.map((item) => <article><div>
              <h3>{item.degree}</h3>
              <p class="org">{item.school}</p>
              <p class="detail">{item.school === 'University of Illinois Urbana-Champaign' ? <>Advisors: <a class="affiliation-link" href="https://siebelschool.illinois.edu/about/people/faculty/dilek" target="_blank" rel="noreferrer">Dilek Hakkani-Tür</a> and <a class="affiliation-link" href="https://siebelschool.illinois.edu/about/people/faculty/gokhan" target="_blank" rel="noreferrer">Gökhan Tür</a> · GPA 3.96 / 4.00</> : item.school === 'National Yang Ming Chiao Tung University' ? <>GPA 3.61 / 4.00 · Last 60 credits GPA 3.94 / 4.00 · Undergraduate research advisor: <a class="affiliation-link" href="https://www.cs.nycu.edu.tw/members/detail/chingchun?locale=en" target="_blank" rel="noreferrer">Ching-Chun Huang</a></> : item.detail}</p>
            </div><p class="dates">{item.dates}</p></article>)}
        </div>
      </section>

      <section class="content-section outside-section" id="outside">
        <div class="section-heading"><p class="eyebrow">Life beyond research</p><h2>Outside the lab</h2></div>
        <p class="outside-motto">Outside the lab, my motto is <strong>“Ball is life.”</strong></p>
        <div class="basketball-stories">
          <article class="basketball-note">
            <img class="basketball-photo" src="/images/basketball-jenny.jpg" alt="Jenny playing basketball for National Yang Ming Chiao Tung University." loading="lazy" />
            <div>
              <h3>Student-athlete & team captain</h3>
              <p>During my undergraduate years at National Yang Ming Chiao Tung University, I competed in Division II of Taiwan’s University Basketball Association (UBA) and served as captain of the school team. I also received the NYCU Women’s Basketball Scholarship.</p>
            </div>
          </article>
          <article class="basketball-us">
            <div class="basketball-us-copy">
              <h3>Continuing My Basketball Journey in the U.S.</h3>
              <p>During my Bay Area internship, I continued my basketball journey with teammates. We celebrated three championships over a wonderful summer on and off the court.</p>
            </div>
            <div class="championship-gallery" aria-label="Summer basketball championship photos">
              <img src="/images/championship-summer-1.jpg" alt="Jenny and her teammates celebrating a championship with medals in the Bay Area." loading="lazy" />
              <img src="/images/championship-summer-2.jpg" alt="Jenny and teammates holding commemorative shirts after a summer basketball championship." loading="lazy" />
              <img src="/images/championship-summer-3.jpg" alt="Jenny and teammates celebrating together after a summer basketball championship." loading="lazy" />
            </div>            </div>
          </article>
        </div>
      </section>



      <section class="content-section cv-section" id="cv">
        <div class="section-heading"><p class="eyebrow">Curriculum vitae</p><h2>CV</h2></div>
        <p class="cv-copy">For a full CV, please reach out through <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>. I’m confirming the email address listed on my current resume before adding a downloadable copy.</p>
      </section>
    </main>

    <footer><span>© {new Date().getFullYear()} Yi-Jyun Sun</span><a href="#top">Back to top ↑</a></footer>
    </div>
  </div>
  <style is:global>
    :root { background:#fff; color:#202321; font-family:'DM Sans',Arial,sans-serif; }
    body { margin:0; }
    a { color:#426a56; text-underline-offset:3px; }
    a:hover { color:#254733; }
    .site-shell { width:min(100% - 64px, 1100px); margin:0 auto; display:grid; grid-template-columns:210px minmax(0,1fr); align-items:start; gap:48px; }
    .profile-sidebar { position:sticky; top:28px; padding:38px 0 24px; }
    .sidebar-photo { display:block; width:min(100%,178px); aspect-ratio:4 / 5; margin:0 0 15px; object-fit:cover; object-position:center 35%; border-radius:3px; }
    .sidebar-name { margin:0 0 7px; font-family:'Newsreader',Georgia,serif; font-size:25px; font-weight:500; letter-spacing:-.025em; line-height:1.12; }
    .sidebar-role,.sidebar-affiliation { margin:0 0 5px; color:#626964; font-size:12px; line-height:1.55; }
    .sidebar-affiliation { margin-bottom:0; }
    .profile-links { display:flex; align-items:center; justify-content:flex-start; gap:9px; padding-top:14px; }
    .profile-link { display:grid; width:34px; height:34px; place-items:center; border:1px solid #e4e9e5; border-radius:50%; color:#53695a; background:#fff; transition:color .18s ease, border-color .18s ease, background .18s ease; }
    .profile-link:hover { color:#254733; border-color:#bdcbbf; background:#f5f8f4; }
    .profile-link:focus-visible { outline:2px solid #426a56; outline-offset:3px; }
    .profile-link svg { display:block; width:16px; height:16px; fill:currentColor; }
    .profile-intro { padding:48px 0 36px; }
    .profile-intro-copy { min-width:0; }
    .profile-intro .lede { max-width:680px; margin:0; color:#4e5550; font-size:16px; line-height:1.75; }
    .profile-intro .lede a { color:#426a56; font-weight:600; text-decoration:underline; text-decoration-color:#9eb4a2; text-decoration-thickness:1px; text-underline-offset:3px; }
    .profile-intro .lede a:hover { color:#254733; text-decoration-color:currentColor; }
    .profile-intro .lede a:focus-visible { outline:2px solid #426a56; outline-offset:3px; border-radius:1px; }
    .page-content { min-width:0; }
    .site-header { position:sticky; top:0; z-index:5; min-height:72px; background:rgba(255,255,255,.96); backdrop-filter:blur(8px); }
    .site-header { min-height:72px; display:flex; align-items:center; justify-content:space-between; gap:24px; border-bottom:1px solid #e9ece9; }
    .wordmark { color:#202321; font-size:14px; font-weight:600; text-decoration:none; white-space:nowrap; }
    .site-header nav { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:20px; }
    .site-header nav a { color:#606762; font-size:12px; text-decoration:none; }
    .site-header nav a:hover { color:#254733; }
    .eyebrow { margin:0 0 10px; color:#68816e; font-size:11px; letter-spacing:.075em; text-transform:uppercase; }
    h1,h2,h3,p { margin-top:0; }
    h1 { margin-bottom:20px; font-family:'Newsreader',Georgia,serif; font-size:54px; font-weight:400; letter-spacing:-.035em; }
    .lede { max-width:660px; margin-bottom:22px; color:#4e5550; font-size:17px; line-height:1.75; }
    .contact-line { margin:0; color:#777e79; font-size:12px; }
    .contact-line span { padding:0 7px; color:#b3b9b4; }
    .contact-line a { color:#4f6b56; }
    .content-section { padding:43px 0 47px; border-top:1px solid #e9ece9; }
    .section-heading { margin-bottom:23px; }
    .section-heading .eyebrow { margin-bottom:5px; }
    h2 { margin-bottom:0; font-family:'Newsreader',Georgia,serif; font-size:31px; font-weight:400; letter-spacing:-.02em; }
    h3 { margin-bottom:4px; font-size:15px; font-weight:600; }
    .research-list { display:grid; grid-template-columns:1fr 1fr; column-gap:38px; }
    .research-item { padding:17px 0 19px; border-top:1px solid #edf0ed; }
    .item-title { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:4px 12px; }
    .item-title span,.research-item small { color:#79807b; font-size:10px; }
    .research-item p { margin:7px 0 8px; color:#626964; font-size:12px; line-height:1.65; }
    .publication-list { margin:0; padding:0; list-style:none; }
    .publication-item { display:grid; grid-template-columns:205px minmax(0,1fr); align-items:start; gap:20px; padding:17px 0; border-top:1px solid #edf0ed; }
    .publication-copy { min-width:0; }
    .paper-title { max-width:650px; margin:0 0 4px; font-size:13px; font-weight:600; line-height:1.55; }
    .paper-authors,.paper-venue { margin:0; color:#707772; font-size:11px; line-height:1.6; }
    .author-self { color:#2e4937; font-weight:700; }
    .paper-venue { margin-top:2px; color:#526b58; }
    .publication-aside { min-width:0; }
    .publication-figure { margin:0; }
    .publication-figure img { display:block; width:100%; height:112px; object-fit:contain; object-position:center; border:1px solid #e5e9e5; background:#f7f8f5; }
    .paper-link { display:inline-block; margin-top:7px; font-size:10px; text-decoration:none; }
    .paper-links { display:flex; gap:14px; }
    .all-papers-link { display:inline-block; margin-top:17px; font-size:11px; text-decoration:none; }
    .all-papers-link span { margin-left:3px; }
    .status { align-self:start; padding-top:2px; color:#a26b45; font-size:9px; letter-spacing:.04em; text-transform:uppercase; white-space:nowrap; }
    .status.published { color:#547259; }
    .service-grid { display:grid; grid-template-columns:1fr 1.4fr; gap:34px; }
    .service-group { padding-top:14px; border-top:1px solid #edf0ed; }
    .service-group h3 { margin-bottom:10px; color:#526b58; font-size:12px; }
    .service-group ul { display:grid; gap:9px; margin:0; padding:0; list-style:none; }
    .service-group li { display:grid; grid-template-columns:74px minmax(0,1fr); gap:10px; color:#626964; font-size:12px; line-height:1.55; }
    .service-year { color:#7c837e; font-size:10px; white-space:nowrap; }
    .experience-item { display:grid; grid-template-columns:66px minmax(0,1fr) auto; align-items:start; gap:13px; padding:16px 0; border-top:1px solid #edf0ed; }
    .education-list article { display:grid; grid-template-columns:1fr auto; align-items:start; gap:18px; padding:16px 0; border-top:1px solid #edf0ed; }
    .company-logo { display:grid; width:66px; height:38px; place-items:center; }
    .company-logo img { display:block; width:auto; height:38px; max-width:66px; object-fit:contain; }
    .org { margin:0 0 6px; color:#566e5c; font-size:12px; }
    .affiliation-link { color:inherit; text-decoration-color:#aebbb0; }
    .affiliation-link:hover { color:#254733; }
    .detail { max-width:600px; margin:0; color:#666d68; font-size:12px; line-height:1.65; }
    .dates { margin:2px 0 0; color:#7c837e; font-size:10px; white-space:nowrap; }
    .outside-motto { margin:-8px 0 24px; color:#626964; font-size:14px; line-height:1.6; }
    .outside-motto strong { color:#355541; font-family:'Newsreader',Georgia,serif; font-size:21px; font-weight:500; }
    .basketball-stories { display:grid; gap:16px; }
    .basketball-note { display:grid; grid-template-columns:235px 1fr; gap:27px; align-items:center; padding:22px; background:#f7f8f5; }
    .basketball-photo { display:block; width:100%; aspect-ratio:1 / 1; object-fit:cover; object-position:center; }
    .basketball-note h3,.basketball-us h3 { margin-bottom:9px; font-family:'Newsreader',Georgia,serif; font-size:23px; font-weight:400; }
    .basketball-note p,.basketball-us p { max-width:560px; margin:0; color:#626964; font-size:13px; line-height:1.75; }
    .basketball-us { display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); align-items:center; gap:22px; padding:22px; background:#f7f8f5; }
    .basketball-us-copy h3 { margin-bottom:7px; font-size:20px; line-height:1.2; }
    .basketball-us p { font-size:12px; line-height:1.65; }
    .basketball-us-copy .eyebrow { margin-bottom:7px; }
    .championship-gallery { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:7px; width:100%; }
    .championship-gallery img { display:block; width:100%; aspect-ratio:4 / 3; object-fit:cover; border-radius:2px; background:#ecefeb; }
    .championship-gallery img:first-child { object-position:center 76%; }
    .championship-gallery img:nth-child(2) { object-position:center 57%; }
    .championship-gallery img:nth-child(3) { object-position:center 55%; }
    
    .cv-copy { margin:0; color:#626964; font-size:13px; line-height:1.7; }
    footer { display:flex; justify-content:space-between; padding:20px 0 30px; border-top:1px solid #e9ece9; color:#89908b; font-size:10px; }
    footer a { text-decoration:none; }
    @media (min-width:481px) and (max-width:760px) {
      .site-shell { width:min(100% - 36px, 1100px); grid-template-columns:150px minmax(0,1fr); gap:25px; }
      .profile-sidebar { top:20px; padding-top:27px; }
      .sidebar-photo { width:140px; margin-bottom:12px; }
      .sidebar-name { font-size:21px; }
      .sidebar-role,.sidebar-affiliation { font-size:10px; }
      .profile-links { gap:7px; padding-top:11px; }
      .profile-link { width:31px; height:31px; }
      .profile-link svg { width:15px; height:15px; }
      .profile-intro { padding:35px 0 28px; }
      .profile-intro .lede { font-size:13px; line-height:1.65; }
      .contact-line { font-size:10px; }
      .site-header nav { gap:12px; }
      .site-header nav a { font-size:10px; }
      .research-list { grid-template-columns:1fr; }
      .service-grid { grid-template-columns:1fr; gap:20px; }
      .publication-item { grid-template-columns:112px minmax(0,1fr); gap:12px; }
      .publication-figure img { height:76px; }
      .basketball-note { grid-template-columns:1fr; gap:18px; padding:19px; }
      .basketball-photo { width:min(100%,320px); }
      .basketball-us { grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); gap:12px; padding:17px; }
      .basketball-us-copy h3 { font-size:18px; line-height:1.2; }
      .basketball-us p { font-size:11px; line-height:1.6; }
      .championship-gallery { gap:4px; }
    }
    @media (max-width:480px) {
      .site-shell { width:min(100% - 36px, 800px); display:block; }
      .profile-sidebar { position:relative; top:auto; display:grid; grid-template-columns:88px minmax(0,1fr); grid-template-areas:"photo name" "photo role" "photo lab" "links links"; align-items:center; gap:3px 14px; padding:20px 0 10px; }
      .sidebar-photo { grid-area:photo; width:88px; margin:0; }
      .sidebar-name { grid-area:name; align-self:end; margin:0; font-size:22px; }
      .sidebar-role { grid-area:role; align-self:center; margin:0; font-size:11px; }
      .sidebar-affiliation { grid-area:lab; align-self:start; margin:0; font-size:11px; }
      .profile-links { grid-area:links; gap:8px; padding-top:11px; }
      .profile-link { width:33px; height:33px; }
      .page-content { width:100%; }
      .profile-intro { padding:19px 0 25px; }
      .profile-intro .lede { font-size:13px; line-height:1.65; }
      .contact-line { font-size:10px; }
      .site-header { align-items:flex-start; flex-direction:column; gap:12px; padding:14px 0; }
      .site-header nav { justify-content:flex-start; gap:12px 17px; }
      .site-header nav a { font-size:11px; }
      .research-list { grid-template-columns:1fr; }
      .service-grid { grid-template-columns:1fr; gap:20px; }
      .publication-item { grid-template-columns:96px minmax(0,1fr); gap:10px; }
      .publication-figure img { height:68px; }
      .experience-item { grid-template-columns:50px minmax(0,1fr); gap:8px 11px; }
      .company-logo { width:46px; }
      .company-logo img { max-width:46px; }
      .experience-item .dates { grid-column:2; grid-row:1; margin-top:0; }
      .experience-item > div { grid-column:2; }
